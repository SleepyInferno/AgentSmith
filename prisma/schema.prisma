generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FreshnessState {
  healthy
  warning
  stale
  error
}

enum SyncStatus {
  healthy
  degraded
  stale
  error
}

enum SyncResult {
  success
  partial
  failure
}

enum AssetSignalStatus {
  healthy
  warning
  missing
  unsupported
  unknown
}

enum AssetRiskLevel {
  low
  watch
  high
  critical
}

enum LifecycleRunKind {
  onboarding
  offboarding
}

enum LifecycleRunStatus {
  active
  completed
}

enum LifecycleStepStatus {
  pending
  automated
  manual
  skipped
  blocked
}

enum NetworkResourceKind {
  site
  wan_link
  lan_segment
  firewall
  switch
  access_point
  dhcp_service
  vpn_service
}

enum NetworkRelationConfidence {
  confirmed
  inferred
}

enum NetworkFindingKind {
  offline_infrastructure
  stale_telemetry
  topology_gap
  unclear_ownership
}

enum BackupCoverageMode {
  required
  excluded
}

enum BackupCoverageState {
  protected
  missing
  partial
  excluded
  unknown
}

enum BackupRestoreState {
  current
  stale
  missing
  unknown
}

enum BackupConfidenceState {
  healthy
  watch
  high_risk
  unknown
}

enum BackupEvidenceSource {
  provider_sync
  operator_attested
}

enum BackupRestoreOutcome {
  success
  partial
  failure
}

enum DocumentKind {
  sop
  vendor_note
  contact
  infrastructure_note
  recovery_procedure
}

enum DocumentReviewState {
  current
  due_soon
  overdue
  unreviewed
}

enum DocumentMetadataDimension {
  site
  owner
  category
}

enum DocumentRevisionType {
  source_sync
  metadata_review
  review_completed
}

model User {
  id               String      @id @default(cuid())
  sourceSystem     String
  sourceId         String
  displayName      String
  email            String?
  jobTitle         String?
  department       String?
  passwordHash     String?
  role             String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  auditEvents      AuditEvent[] @relation("AuditActor")

  @@unique([sourceSystem, sourceId])
}

model Device {
  id                    String                       @id @default(cuid())
  sourceSystem          String
  sourceId              String
  name                  String
  serialNumber          String?
  operatingSystem       String?
  complianceState       String?
  ownerId               String?
  departmentSnapshot    String?
  siteSnapshot          String?
  encryptionStatus      AssetSignalStatus?
  antivirusStatus       AssetSignalStatus?
  patchStatus           AssetSignalStatus?
  diskFreePercent       Int?
  deviceAgeDays         Int?
  supportStatus         AssetSignalStatus?
  lastCheckInAt         DateTime?
  lastSeenAt            DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  riskAssessment        DeviceRiskAssessment?
  complianceAssignments DeviceComplianceAssignment[]

  @@unique([sourceSystem, sourceId])
}

model DeviceRiskAssessment {
  id                   String         @id @default(cuid())
  deviceId             String         @unique
  device               Device         @relation(fields: [deviceId], references: [id])
  riskScore            Int
  riskLevel            AssetRiskLevel
  queueRank            Int
  sourceFreshnessState FreshnessState
  summary              String
  signals              Json
  calculatedAt         DateTime       @default(now())
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model DeviceCompliancePolicy {
  id           String                      @id @default(cuid())
  sourceSystem String
  sourceId     String
  name         String
  platform     String
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  assignments  DeviceComplianceAssignment[]

  @@unique([sourceSystem, sourceId])
}

model DeviceComplianceAssignment {
  id             String                 @id @default(cuid())
  deviceId       String
  device         Device                 @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  policyId       String
  policy         DeviceCompliancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  status         String
  lastReportedAt DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([deviceId, policyId])
  @@index([deviceId])
}

model System {
  id                   String               @id @default(cuid())
  sourceSystem         String
  sourceId             String
  name                 String
  category             String?
  ownerTeam            String?
  criticality          String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  backupCoveragePolicy BackupCoveragePolicy?
  backupEvidence       BackupEvidence[]
  backupRestoreTests   BackupRestoreTest[]
  documentationLinks DocumentSystemLink[]

  @@unique([sourceSystem, sourceId])
}

model Group {
  id               String   @id @default(cuid())
  sourceSystem     String
  sourceId         String
  name             String
  groupType        String?
  description      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([sourceSystem, sourceId])
}

model Document {
  id                  String                     @id @default(cuid())
  sourceSystem        String
  sourceId            String
  title               String
  kind                DocumentKind               @default(sop)
  category            String?
  owner               String?
  summary             String?                    @db.Text
  contentText         String                     @default("") @db.Text
  searchText String @default("") @db.Text
  reviewState         DocumentReviewState        @default(unreviewed)
  reviewDueAt         DateTime?
  lastReviewedAt      DateTime?
  sourceUpdatedAt     DateTime?
  contentUpdatedAt    DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  metadataAssignments DocumentMetadataAssignment[]
  systemLinks         DocumentSystemLink[]
  revisions           DocumentRevision[]
  embeddings          DocumentEmbedding[]

  @@unique([sourceSystem, sourceId])
}

model DocumentMetadataAssignment {
  id         String                    @id @default(cuid())
  documentId String
  document   Document                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  dimension  DocumentMetadataDimension
  valueKey   String
  valueLabel String
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  @@unique([documentId, dimension, valueKey])
  @@index([dimension, valueKey])
}

model DocumentSystemLink {
  id                String   @id @default(cuid())
  documentId        String
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  systemId          String
  system            System   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  relationshipLabel String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([documentId, systemId, relationshipLabel])
  @@index([systemId])
}

model DocumentRevision {
  id            String              @id @default(cuid())
  documentId    String
  document      Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revisionType  DocumentRevisionType
  summary       String
  changedFields String[]
  actorLabel    String?
  reviewState   DocumentReviewState
  reviewDueAt   DateTime?
  createdAt     DateTime            @default(now())

  @@index([documentId, createdAt(sort: Desc)])
}

model ConnectorSource {
  id                  String         @id @default(cuid())
  key                 String         @unique
  label               String
  sourceSystem        String
  syncStatus          SyncStatus     @default(stale)
  freshnessState      FreshnessState @default(stale)
  lastSuccessfulSyncAt DateTime?
  lastAttemptedSyncAt DateTime?
  lastError           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  syncRuns            SyncRun[]
}

model SyncRun {
  id                  String          @id @default(cuid())
  connectorSourceId   String
  connectorSource     ConnectorSource @relation(fields: [connectorSourceId], references: [id])
  startedAt           DateTime
  completedAt         DateTime?
  result              SyncResult
  recordsSeen         Int             @default(0)
  recordsNormalized   Int             @default(0)
  metadata            Json?
  createdAt           DateTime        @default(now())
}

model AuditEvent {
  id          String    @id @default(cuid())
  timestamp   DateTime  @default(now())
  actorId     String?
  actor       User?     @relation("AuditActor", fields: [actorId], references: [id])
  action      String
  targetType  String
  targetId    String?
  result      String
  metadata    Json
  createdAt   DateTime  @default(now())
}

model LifecycleRun {
  id                 String               @id @default(cuid())
  kind               LifecycleRunKind
  templateKey        String
  templateVersion    Int
  subjectDisplayName String
  subjectEmail       String?
  requestedBy        String
  status             LifecycleRunStatus   @default(active)
  startedAt          DateTime             @default(now())
  closedAt           DateTime?
  updatedAt          DateTime             @updatedAt
  groups             LifecycleRunGroup[]
  steps              LifecycleRunStep[]

  @@index([status, updatedAt(sort: Desc)])
  @@index([templateKey, startedAt(sort: Desc)])
}

model LifecycleRunGroup {
  id         String             @id @default(cuid())
  runId      String
  run        LifecycleRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  key        String
  title      String
  position   Int
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  steps      LifecycleRunStep[]

  @@unique([runId, key])
  @@index([runId, position])
}

model LifecycleRunStep {
  id           String              @id @default(cuid())
  runId        String
  run          LifecycleRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  groupId      String?
  group        LifecycleRunGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  key          String
  title        String
  instructions String
  groupKey     String
  position     Int
  status       LifecycleStepStatus @default(pending)
  statusReason String?
  note         String?
  ticketId     String?
  assetId      String?
  mailboxRef   String?
  handoffRef   String?
  completedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([runId, groupKey, position])
  @@unique([runId, key])
}

model NetworkResource {
  id                    String                @id @default(cuid())
  sourceSystem          String
  sourceId              String
  kind                  NetworkResourceKind
  name                  String
  siteName              String?
  operationalStatus     String?
  freshnessState        FreshnessState        @default(stale)
  lastSeenAt            DateTime?
  managementIp          String?
  cidr                  String?
  ownerLabel            String?
  metadata              Json?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  outgoingRelationships NetworkRelationship[] @relation("NetworkRelationshipFrom")
  incomingRelationships NetworkRelationship[] @relation("NetworkRelationshipTo")
  findings              NetworkFinding[]

  @@unique([sourceSystem, sourceId])
  @@index([kind, siteName])
  @@index([freshnessState, lastSeenAt(sort: Desc)])
}

model NetworkRelationship {
  id             String                    @id @default(cuid())
  fromResourceId String
  fromResource   NetworkResource           @relation("NetworkRelationshipFrom", fields: [fromResourceId], references: [id], onDelete: Cascade)
  toResourceId   String
  toResource     NetworkResource           @relation("NetworkRelationshipTo", fields: [toResourceId], references: [id], onDelete: Cascade)
  relationship   String
  confidence     NetworkRelationConfidence
  sourceSystem   String
  lastSeenAt     DateTime?
  metadata       Json?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([fromResourceId])
  @@index([toResourceId])
  @@index([confidence, lastSeenAt(sort: Desc)])
}

model NetworkFinding {
  id                String             @id @default(cuid())
  resourceId        String
  resource          NetworkResource    @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  kind              NetworkFindingKind
  severity          AssetRiskLevel
  summary           String
  suggestedNextStep String
  queueRank         Int
  siteName          String?
  scopeLabel        String?
  freshnessState    FreshnessState     @default(stale)
  lastSeenAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([queueRank, severity])
  @@index([siteName, freshnessState])
}

model BackupCoveragePolicy {
  id                    String             @id @default(cuid())
  systemId              String             @unique
  system                System             @relation(fields: [systemId], references: [id], onDelete: Cascade)
  coverageMode          BackupCoverageMode
  backupFreshnessHours  Int?
  restoreTestMaxAgeDays Int?
  gracePeriodHours      Int?
  providerScope         Json?
  exclusionReason       String?
  notes                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([coverageMode])
}

model BackupEvidence {
  id                     String                @id @default(cuid())
  systemId               String
  system                 System                @relation(fields: [systemId], references: [id], onDelete: Cascade)
  providerKey            String
  workloadKind           String
  sourceSystem           String
  sourceId               String
  coverageState          BackupCoverageState   @default(unknown)
  lastSuccessfulBackupAt DateTime?
  lastFailedBackupAt     DateTime?
  backupFreshnessState   BackupRestoreState    @default(unknown)
  connectorFreshnessState BackupRestoreState   @default(unknown)
  lastObservedAt         DateTime?
  metadata               Json?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  restoreTests           BackupRestoreTest[]

  @@unique([providerKey, sourceSystem, sourceId])
  @@index([systemId, coverageState])
  @@index([providerKey, workloadKind])
  @@index([lastObservedAt(sort: Desc)])
}

model BackupRestoreTest {
  id               String               @id @default(cuid())
  systemId         String
  system           System               @relation(fields: [systemId], references: [id], onDelete: Cascade)
  backupEvidenceId String?
  backupEvidence   BackupEvidence?      @relation(fields: [backupEvidenceId], references: [id], onDelete: SetNull)
  evidenceSource   BackupEvidenceSource
  outcome          BackupRestoreOutcome
  testedAt         DateTime
  recoveryPointAt  DateTime?
  ticketRef        String?
  notes            String?
  metadata         Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([systemId, testedAt(sort: Desc)])
  @@index([backupEvidenceId])
  @@index([evidenceSource, testedAt(sort: Desc)])
}

model IntegrationCredential {
  id             String    @id @default(cuid())
  key            String    @unique
  encryptedValue String    @db.Text
  iv             String
  authTag        String
  lastTestedAt   DateTime?
  lastTestResult String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model SystemKey {
  id         String   @id @default(cuid())
  purpose    String   @unique
  wrappedKey String   @db.Text
  createdAt  DateTime @default(now())
}

model DocumentEmbedding {
  id         String                        @id @default(cuid())
  documentId String
  document   Document                      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  chunkText  String                        @db.Text
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                      @default(now())

  @@index([documentId])
}
