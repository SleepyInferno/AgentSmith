generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FreshnessState {
  healthy
  warning
  stale
  error
}

enum SyncStatus {
  healthy
  degraded
  stale
  error
}

enum SyncResult {
  success
  partial
  failure
}

enum AssetSignalStatus {
  healthy
  warning
  missing
  unsupported
  unknown
}

enum AssetRiskLevel {
  low
  watch
  high
  critical
}

enum LifecycleRunKind {
  onboarding
  offboarding
}

enum LifecycleRunStatus {
  active
  completed
}

enum LifecycleStepStatus {
  pending
  automated
  manual
  skipped
  blocked
}

model User {
  id               String      @id @default(cuid())
  sourceSystem     String
  sourceId         String
  displayName      String
  email            String?
  jobTitle         String?
  department       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  auditEvents      AuditEvent[] @relation("AuditActor")

  @@unique([sourceSystem, sourceId])
}

model Device {
  id                  String                @id @default(cuid())
  sourceSystem        String
  sourceId            String
  name                String
  serialNumber        String?
  operatingSystem     String?
  complianceState     String?
  ownerId             String?
  departmentSnapshot  String?
  siteSnapshot        String?
  encryptionStatus    AssetSignalStatus?
  antivirusStatus     AssetSignalStatus?
  patchStatus         AssetSignalStatus?
  diskFreePercent     Int?
  deviceAgeDays       Int?
  supportStatus       AssetSignalStatus?
  lastCheckInAt       DateTime?
  lastSeenAt          DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  riskAssessment      DeviceRiskAssessment?

  @@unique([sourceSystem, sourceId])
}

model DeviceRiskAssessment {
  id                   String         @id @default(cuid())
  deviceId             String         @unique
  device               Device         @relation(fields: [deviceId], references: [id])
  riskScore            Int
  riskLevel            AssetRiskLevel
  queueRank            Int
  sourceFreshnessState FreshnessState
  summary              String
  signals              Json
  calculatedAt         DateTime       @default(now())
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model System {
  id               String   @id @default(cuid())
  sourceSystem     String
  sourceId         String
  name             String
  category         String?
  ownerTeam        String?
  criticality      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([sourceSystem, sourceId])
}

model Group {
  id               String   @id @default(cuid())
  sourceSystem     String
  sourceId         String
  name             String
  groupType        String?
  description      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([sourceSystem, sourceId])
}

model Document {
  id               String   @id @default(cuid())
  sourceSystem     String
  sourceId         String
  title            String
  category         String?
  owner            String?
  reviewDueAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([sourceSystem, sourceId])
}

model ConnectorSource {
  id                  String         @id @default(cuid())
  key                 String         @unique
  label               String
  sourceSystem        String
  syncStatus          SyncStatus     @default(stale)
  freshnessState      FreshnessState @default(stale)
  lastSuccessfulSyncAt DateTime?
  lastAttemptedSyncAt DateTime?
  lastError           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  syncRuns            SyncRun[]
}

model SyncRun {
  id                  String          @id @default(cuid())
  connectorSourceId   String
  connectorSource     ConnectorSource @relation(fields: [connectorSourceId], references: [id])
  startedAt           DateTime
  completedAt         DateTime?
  result              SyncResult
  recordsSeen         Int             @default(0)
  recordsNormalized   Int             @default(0)
  metadata            Json?
  createdAt           DateTime        @default(now())
}

model AuditEvent {
  id          String    @id @default(cuid())
  timestamp   DateTime  @default(now())
  actorId     String?
  actor       User?     @relation("AuditActor", fields: [actorId], references: [id])
  action      String
  targetType  String
  targetId    String?
  result      String
  metadata    Json
  createdAt   DateTime  @default(now())
}

model LifecycleRun {
  id                 String               @id @default(cuid())
  kind               LifecycleRunKind
  templateKey        String
  templateVersion    Int
  subjectDisplayName String
  subjectEmail       String?
  requestedBy        String
  status             LifecycleRunStatus   @default(active)
  startedAt          DateTime             @default(now())
  closedAt           DateTime?
  updatedAt          DateTime             @updatedAt
  groups             LifecycleRunGroup[]
  steps              LifecycleRunStep[]

  @@index([status, updatedAt(sort: Desc)])
  @@index([templateKey, startedAt(sort: Desc)])
}

model LifecycleRunGroup {
  id         String             @id @default(cuid())
  runId      String
  run        LifecycleRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  key        String
  title      String
  position   Int
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  steps      LifecycleRunStep[]

  @@unique([runId, key])
  @@index([runId, position])
}

model LifecycleRunStep {
  id           String              @id @default(cuid())
  runId        String
  run          LifecycleRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  groupId      String?
  group        LifecycleRunGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  key          String
  title        String
  instructions String
  groupKey     String
  position     Int
  status       LifecycleStepStatus @default(pending)
  statusReason String?
  note         String?
  ticketId     String?
  assetId      String?
  mailboxRef   String?
  handoffRef   String?
  completedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([runId, groupKey, position])
  @@unique([runId, key])
}
