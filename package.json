{
  "name": "agentsmith",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.11.1",
  "dependencies": {
    "@prisma/client": "^6.6.0"
  },
  "devDependencies": {
    "prisma": "^6.6.0",
    "tsx": "^4.21.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @agentsmith/api --filter @agentsmith/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "test": "pnpm --filter @agentsmith/api test && pnpm --filter @agentsmith/web test && pnpm --filter @agentsmith/web test:e2e",
    "test:api": "pnpm --filter @agentsmith/api test",
    "test:web": "pnpm --filter @agentsmith/web test && pnpm --filter @agentsmith/web test:e2e"
  }
}
